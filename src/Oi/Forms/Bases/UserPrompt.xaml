<Window
    x:Class="Oi.Forms.UserPrompt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Width="400"
    Style="{DynamicResource Style_Window}"
    WindowStartupLocation="CenterScreen"
    Title="OI: MESSAGE">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Oi;component/Resources/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Message -->
        <TextBlock x:Name="MessageTextBlock"
           Grid.Row="0"
           TextWrapping="Wrap"
           MinHeight="80"
           Margin="0,0,0,16"/>

        <!-- Buttons -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AcceptColumn"
                          Width="*"/>
                <ColumnDefinition x:Name="CancelColumn"
          Width="*"/>
            </Grid.ColumnDefinitions>


            <Button x:Name="CancelButton"
            Grid.Column="1"
            Content="CANCEL"
            Margin="4,0,0,0"
            Click="CancelButton_Click"/>


            <Button x:Name="AcceptButton"
            Grid.Column="0"
            Content="OK"
            Margin="0,0,4,0"
            Click="AcceptButton_Click"/>

        </Grid>

    </Grid>

</Window>