<Window
    x:Class="Oi.Forms.ProtectionReasonPrompt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Width="420"
    Style="{DynamicResource Style_Window}"
    WindowStartupLocation="CenterScreen"
    Title="OI: PROTECTION REASON">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Oi;component/Resources/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Instructions -->
        <TextBlock
            Grid.Row="0"
            TextWrapping="Wrap"
            Margin="0,0,0,12"
            Text="Provide a brief description explaining the protection reason.">
        </TextBlock>


        <!-- Reason Input -->
        <TextBox
    x:Name="ReasonTextBox"
    Grid.Row="1"
    TextWrapping="Wrap"
    AcceptsReturn="True"
    VerticalScrollBarVisibility="Auto"
    VerticalContentAlignment="Top"
    TextChanged="ReasonTextBox_TextChanged"
            Height="Auto"/>


        <!-- Buttons -->
        <Grid Grid.Row="2"
              Margin="0,16,0,0">

            <Button x:Name="AcceptButton"
                    Grid.Column="0"
                    Content="OK"
                    IsEnabled="False"
                    Margin="0,0,4,0"
                    Click="AcceptButton_Click"/>
        </Grid>

    </Grid>

</Window>